generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EXECUTIVE
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectHealth {
  GREEN
  AMBER
  RED
  UNKNOWN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum ReportRag {
  GREEN
  AMBER
  RED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLikelihood {
  LOW
  MEDIUM
  HIGH
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users       User[]
  projects    Project[]

  @@index([name])
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(VIEWER)
  departmentId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedProjects Project[]   @relation("ProjectOwner")
  createdReports StatusReport[] @relation("ReportCreator")
  ownedRisks     Risk[]      @relation("RiskOwner")
  projectVisibilityGrants ProjectVisibilityGrant[]

  @@index([role])
  @@index([departmentId])
}

model Project {
  id                 Int            @id @default(autoincrement())
  name               String
  code               String         @unique
  description        String?
  status             ProjectStatus  @default(PLANNING)
  health             ProjectHealth  @default(UNKNOWN)
  isAtRisk           Boolean        @default(false)
  ownerId            Int
  departmentId       Int
  plannedStartDate   DateTime?
  actualStartDate    DateTime?
  plannedEndDate     DateTime?
  actualEndDate      DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  owner              User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  department         Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  statusReports      StatusReport[]
  risks              Risk[]
  budgets            Budget[]
  viewerGrants       ProjectVisibilityGrant[]

  @@index([status])
  @@index([departmentId])
  @@index([ownerId])
  @@index([plannedEndDate])
  @@index([departmentId, status])
  @@index([departmentId, plannedEndDate])
}

model StatusReport {
  id                 Int          @id @default(autoincrement())
  projectId          Int
  createdById        Int
  reportingPeriodStart DateTime
  reportingPeriodEnd   DateTime
  dueDate            DateTime
  status             ReportStatus @default(DRAFT)
  rag                ReportRag    @default(AMBER)
  progressPercentage Int          @default(0)
  summary            String?
  blockers           String?
  submittedAt        DateTime?
  publishedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User         @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, reportingPeriodStart, reportingPeriodEnd], name: "unique_project_period_report")
  @@index([projectId])
  @@index([dueDate])
  @@index([status])
  @@index([rag])
  @@index([dueDate, status])
}

model Risk {
  id              Int             @id @default(autoincrement())
  projectId       Int
  title           String
  description     String?
  severity        RiskSeverity    @default(MEDIUM)
  likelihood      RiskLikelihood  @default(MEDIUM)
  mitigationPlan  String?
  ownerId         Int
  isEscalated     Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner           User            @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([severity])
  @@index([likelihood])
  @@index([ownerId])
}

model Budget {
  id            Int       @id @default(autoincrement())
  projectId     Int
  periodStart   DateTime
  periodEnd     DateTime
  year          Int
  quarter       Int
  plannedAmount Decimal   @db.Decimal(12, 2)
  actualAmount  Decimal   @db.Decimal(12, 2)
  currency      String    @default("USD")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([periodStart])
  @@index([projectId, year, quarter])
}

model ProjectVisibilityGrant {
  id        Int      @id @default(autoincrement())
  userId    Int
  projectId Int
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
